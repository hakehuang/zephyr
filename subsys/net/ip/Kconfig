230: config NET_IPV4_MAPPING_TO_IPV6
231: 	bool "Support IPv4 mapped on IPv6 addresses"
232: 	depends on NET_NATIVE_IPV6
233: 	help
234: 	  Support v4-mapped-on-v6 address type. This allows IPv4 and IPv6
235: 	  to share a local port space. When the application gets an IPv4
236: 	  connection or packet to an IPv6 socket, its source address will
237: 	  be mapped to IPv6. This is turned off by default which means
238: 	  that IPV6_V6ONLY socket option is always on. If you enable this
239: 	  option, then you can still control the behaviour of the socket
240: 	  via the IPV6_V6ONLY option at runtime.
241: 
242: config NET_TC_TX_COUNT
243: 	int "How many Tx traffic classes to have for each network device"
244: 	default 1 if USERSPACE || USB_DEVICE_NETWORK || \
245: 		     USBD_CDC_ECM_CLASS || USBD_CDC_NCM_CLASS || \
246: 		     NET_SHELL_REQUIRE_TX_THREAD
247: 	default 0
248: 	range 1 NET_TC_NUM_PRIORITIES if NET_TC_NUM_PRIORITIES<=8 && \
249: 		(USERSPACE || NET_SHELL_REQUIRE_TX_THREAD)
250: 	range 0 NET_TC_NUM_PRIORITIES if NET_TC_NUM_PRIORITIES<=8
251: 	range 1 8 if USERSPACE || NET_SHELL_REQUIRE_TX_THREAD
252: 	range 0 8
253: 	help
254: 	  Define how many Tx traffic classes (queues) the system should have
255: 	  when sending a network packet. The network packet priority can then
256: 	  be mapped to this traffic class so that higher prioritized packets
257: 	  can be processed before lower prioritized ones. Each queue is handled
258: 	  by a separate thread which will need RAM for stack space.
259: 	  Only increase the value from 1 if you really need this feature.
260: 	  The default value is 1 which means that all the network traffic is
261: 	  handled equally. In this implementation, the higher traffic class
262: 	  value corresponds to lower thread priority.
263: 	  If you select 0 here, then it means that all the network traffic
264: 	  is pushed to the driver directly without any queues.
265: 	  Note that if USERSPACE support is enabled, then currently we need to
266: 	  enable at least 1 TX thread.
267: 
268: config NET_TC_RX_COUNT
269: 	int "How many Rx traffic classes to have for each network device"
270: 	default 1
271: 	range 1 NET_TC_NUM_PRIORITIES if NET_TC_NUM_PRIORITIES<=8 && USERSPACE
272: 	range 0 NET_TC_NUM_PRIORITIES if NET_TC_NUM_PRIORITIES<=8
273: 	range 1 8 if USERSPACE
274: 	range 0 8
275: 	help
276: 	  Define how many Rx traffic classes (queues) the system should have
277: 	  when receiving a network packet. The network packet priority can then
278: 	  be mapped to this traffic class so that higher prioritized packets
279: 	  can be processed before lower prioritized ones. Each queue is handled
280: 	  by a separate thread which will need RAM for stack space.
281: 	  Only increase the value from 1 if you really need this feature.
282: 	  The default value is 1 which means that all the network traffic is
283: 	  handled equally. In this implementation, the higher traffic class
284: 	  value corresponds to lower thread priority.
285: 	  If you select 0 here, then it means that all the network traffic
286: 	  is pushed from the driver to application thread without any
287: 	  intermediate RX queue. There is always a receive socket queue between
288: 	  device driver and application. Disabling RX thread means that the
289: 	  network device driver, that is typically running in IRQ context, will
290: 	  handle the packet all the way to the application. This might cause
291: 	  other incoming packets to be lost if the RX processing takes long
292: 	  time.
293: 	  Note that if USERSPACE support is enabled, then currently we need to
294: 	  enable at least 1 RX thread.
295: 
296: config NET_TC_SKIP_FOR_HIGH_PRIO
297: 	bool "Push high priority packets directly to network driver [DEPRECATED]"
298: 	select DEPRECATED
299: 	help
300: 	  Deprecated, use NET_TC_TX_SKIP_FOR_HIGH_PRIO instead.
301: 
302: config NET_TC_TX_SKIP_FOR_HIGH_PRIO
303: 	bool "Push high priority packets directly to network driver"
304: 	default NET_TC_SKIP_FOR_HIGH_PRIO
305: 	help
306: 	  If this is set, then high priority (>= NET_PRIORITY_CA) net_pkt will
307: 	  be pushed directly to network driver and will skip the traffic class
308: 	  queues. This is currently not enabled by default.
309: 
310: config NET_TC_RX_SKIP_FOR_HIGH_PRIO
311: 	bool "Push high priority packets directly to the application"
312: 	help
313: 	  If this is set, then high priority (>= NET_PRIORITY_CA) net_pkt will
314: 	  be pushed directly to the application and will skip the traffic class
315: 	  queues. If you select this option, then it means that high priority
316: 	  network traffic is pushed from the driver to the application thread
317: 	  without any intermediate RX queue. If the network device driver is
318: 	  running in IRQ context, it will handle the packet all the way to the
319: 	  application. This might cause other incoming packets to be lost if
320: 	  the RX processing takes long time.
321: 	  This is currently not enabled by default.
322: 
